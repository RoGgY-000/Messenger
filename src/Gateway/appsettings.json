{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "Auth": "http://auth_service:5010",
    "Chat": "http://chat_service:5010",
    "Connection": "http://connection_service:5010"
  },
  "ReverseProxy": {
    "Routes": {
      "signalr": {
        "ClusterId": "connection_cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/hubs/chat/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "connection_cluster": {
        "Destinations": {
          "connection_service": {
            "Address": "http://connection_service:8080"
          }
        }
      }
    }
  }
}