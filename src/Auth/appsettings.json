{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "GrpcEndpoint": {
        "Protocols": "Http2",
        "Url": "http://*:5010"
      },
      "MetricsEndpoint": {
        "Protocols": "Http1",
        "Url": "http://*:5011"
      }
    }
  }
}