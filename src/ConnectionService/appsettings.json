{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "Auth": "http://auth_service:5010",
    "Chat": "http://chat_service:5010"
  },
    "Kestrel": {
      "Endpoints": {
        "SignalR": {
          "Protocols": "Http1AndHttp2",
          "Url": "http://*:8080"
        },
        "GrpcEndpoint": {
          "Protocols": "Http2",
          "Url": "http://*:5010"
        },
        "MetricsEndpoint": {
          "Protocols": "Http1",
          "Url": "http://*:5011"
        }
      }
    }
  }
